IDIR=../include
CXX=g++
CXXFLAGS=-I$(IDIR)

ODIR=obj
LDIR=../lib

_DEPS = hellomake.h
DEPS = $(patsubst %,$(IDIR)/%,$(_DEPS))

_OBJ = hellomake.o hellofunc.o 
OBJ = $(patsubst %,$(ODIR)/%,$(_OBJ))

# Para usar este Makefile, se necesita
# la siguiente estructura de directorios:
#
# P06-alternatives-iterations
# |- include/
# |  '- hellomake.h
# |- make-tutorial/
# :  |- obj/
#    |- hellomake.cc
#    |- hellofunc.cc
#    :
#    '- makefile.5

$(ODIR)/%.o: %.cc $(DEPS)
	$(CXX) -c -o $@ $< $(CXXFLAGS)

hellomake: $(OBJ)
	$(CXX) -o $@ $^ $(CXXFLAGS)

.PHONY: clean

clean:
	rm -f $(ODIR)/*.o *~ core $(IDIR)/*~ 
